# Django Secret Key (use a secure random string in production)
SECRET_KEY=django-insecure-example-key-change-in-production

# Debug Mode (set to False for production)
DEBUG=True

# Allowed Hosts (comma-separated). For LAN deployment, append Computer A's LAN IP:
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins (comma-separated). For LAN deployment, append Computer A's frontend LAN URL:
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.10:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL on Computer A; accessible locally by Django only)
DB_NAME=nforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Gemini AI API Key
GEMINI_API_KEY=

# MCP (Model Context Protocol) Configuration
# Set MCP_ENABLED=true to enforce MCP as the exclusive LLM tool interface
MCP_ENABLED=false
# URL for the dedicated MCP server (SSE transport)
MCP_SERVER_URL=http://127.0.0.1:8001/sse
# Shared secret authentication key between Django and MCP server
MCP_AUTH_KEY=nforge-local-dev-mcp-key-change-in-production
# Maximum tool execution iterations per AI question
MCP_MAX_TOOL_ITERATIONS=5
