# Backend API Base URL
# For local single-machine development:
VITE_API_URL=http://localhost:8000/api

# For two-computer LAN deployment:
# Set this to Computer A's LAN IP address found via `ipconfig` on Computer A.
# Example: VITE_API_URL=http://192.168.1.10:8000/api
# (Note: trailing '/api' is optional; the frontend automatically handles both formats)
